# ── .env.example — copy to .env and fill in real values ─────
# This file is safe to commit. Never commit .env itself.

APP_ENV=local

# Database
DB_HOST=localhost
DB_NAME=ssquares_db
DB_USER=root
DB_PASS=

# Security
JWT_SECRET=change_this_to_a_long_random_string

# Uploads
UPLOAD_URL=/assets/uploads/

# reCAPTCHA (get from console.cloud.google.com)
RECAPTCHA_SECRET=

# Gmail OAuth (for contact form)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
TO_EMAIL=

# CORS origin
CORS_ORIGIN=http://localhost:5173
